{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(evaluation_trials_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Trial rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "max": 1, "min": 0, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(evaluation_trial_errors_total[$__rate_interval])) / clamp_min(sum(rate(evaluation_trials_total[$__rate_interval])), 0.001)",
          "refId": "A"
        }
      ],
      "title": "System error ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(evaluation_target_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "title": "Target p95 duration",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(evaluation_export_errors_total[$__range]))",
          "refId": "A"
        }
      ],
      "title": "Export errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (evaluation_status) (rate(evaluation_trials_total[$__rate_interval]))",
          "legendFormat": "{{evaluation_status}}",
          "refId": "A"
        }
      ],
      "title": "Trial outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(evaluation_target_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 target",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(evaluation_target_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 target",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(evaluation_grader_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 grader",
          "refId": "C"
        }
      ],
      "title": "Operation latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(evaluation_trial_errors_total[$__rate_interval]))",
          "legendFormat": "trial: {{error_type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (error_type) (rate(evaluation_target_errors_total[$__rate_interval]))",
          "legendFormat": "target: {{error_type}}",
          "refId": "B"
        },
        {
          "expr": "sum by (error_type) (rate(evaluation_grader_errors_total[$__rate_interval]))",
          "legendFormat": "grader: {{error_type}}",
          "refId": "C"
        }
      ],
      "title": "Errors by type",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["langgraph", "evaluation", "red"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "LangGraph Evaluation RED",
  "uid": "langgraph-evaluation-red",
  "version": 1
}
